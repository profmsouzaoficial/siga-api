# Variáveis de ambiente — copie para `.env` (que está no .gitignore)

# ---------------------------------------------------------------------------
# Obrigatórias
# ---------------------------------------------------------------------------
SIGA_CPF=seu_cpf_aqui
SIGA_SENHA=sua_senha_aqui
API_SECRET_KEY=crie_uma_chave_segura

# ---------------------------------------------------------------------------
# Opcionais
# ---------------------------------------------------------------------------
# Período usado quando o cliente não envia "periodo" nas rotas de escrita.
# SIGA_PERIODO_PADRAO=2026/3

# Timeout (segundos) de cada requisição ao SIGA.
# SIGA_TIMEOUT=30

# ID interno do docente, só é preciso se o SIGA não enviar o campo na página
# de filtro (normalmente é descoberto sozinho).
# SIGA_ID_DOCENTE=29230

# Mapa manual de períodos, útil quando o SIGA muda o HTML do filtro:
# SIGA_PERIODO_IDS=2026/3=268,2026/2=267

# Tipo de cálculo padrão ao criar TVC (Soma, Média, ...).
# SIGA_TIPO_CALCULO=Soma

# Nível de log: DEBUG, INFO, WARNING, ERROR.
# LOG_LEVEL=INFO

# Origens liberadas no CORS (separadas por vírgula). Vazio = CORS desligado.
# API_CORS_ORIGINS=https://meu-painel.exemplo.br

# Pasta onde cada HTML baixado do SIGA é salvo (ajuda a diagnosticar mudanças
# de layout). Contém dados pessoais de alunos: não versione essa pasta.
# SIGA_DEBUG_DIR=debug_html
